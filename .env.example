MONGODB_URI=your_mongodb_connection_string
REDIS_URL=redis://default:password@host:6379
JWT_SECRET=your_jwt_secret
FRONTEND_URL=https://your-frontend.onrender.com
BACKEND_URL=https://your-backend.onrender.com
RGE_INTERNAL_TOKEN=your_shared_internal_rge_token

SQUARE_ACCESS_TOKEN=your_square_access_token
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=your_square_location_id
# Optional: backend will auto-select an ACTIVE location available to the token if this is blank/invalid.
SQUARE_WEBHOOK_SECRET=your_square_webhook_secret
SQUARE_WEBHOOK_NOTIFICATION_URL=https://your-backend.onrender.com/api/webhook/square-webhook
SQUARE_VIP_PLAN_ID=your_square_subscription_plan_variation_id
SQUARE_VIP_PRICE_CENTS=xxx

MIN_WITHDRAWAL_AMOUNT=5

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user_or_email
SMTP_PASS=your_smtp_password
EMAIL_FROM_ADDRESS=no-reply@yourdomain.com
EMAIL_FROM_NAME=ReemTeam
# Optional
APP_NAME=ReemTeam
PASSWORD_RESET_EMAIL_SUBJECT=Reset your ReemTeam password
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# Mailgun (preferred when available)
